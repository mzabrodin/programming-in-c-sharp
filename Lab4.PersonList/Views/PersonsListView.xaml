<UserControl x:Class="Lab4.PersonList.Views.PersonsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lab4.PersonList.Views"
             xmlns:convertors="clr-namespace:Lab4.PersonList.Convertors"
             xmlns:viewModels="clr-namespace:Lab4.PersonList.ViewModels"
             xmlns:models="clr-namespace:Lab4.PersonList.Models"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:PersonListViewModel}">
    <UserControl.Resources>
        <convertors:BooleanToDisplayValueConverter x:Key="BooleanToDisplayValueConverter"
                                                   TrueDisplayValue="Yes"
                                                   FalseDisplayValue="No" />
        <convertors:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"
                                                 TrueVisibility="Visible"
                                                 FalseVisibility="Hidden" />
    </UserControl.Resources>
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Person List"
                           Margin="5"
                           FontSize="20"
                           FontWeight="Bold" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="5"
                        Padding="10 3 10 3"
                        MinWidth="75"
                        FontSize="14"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Create person"
                        Command="{Binding GoToPersonCreateCommand}"
                        Width="125" />
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Sort by category: "
                           Margin="5"
                           FontSize="14" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          MinWidth="125"
                          FontSize="14"
                          Margin="5"
                          SelectedValue="{Binding SortListProperty, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="None"
                                  Tag="{x:Static models:PersonListProperty.None}"
                                  Visibility="Collapsed"/>
                    <ComboBoxItem Content="Name"
                                  Tag="{x:Static models:PersonListProperty.Name}" />
                    <ComboBoxItem Content="Surname"
                                  Tag="{x:Static models:PersonListProperty.Surname}" />
                    <ComboBoxItem Content="Email"
                                  Tag="{x:Static models:PersonListProperty.Email}" />
                    <ComboBoxItem Content="Birthday"
                                  Tag="{x:Static models:PersonListProperty.Birthday}" />
                    <ComboBoxItem Content="Age"
                                  Tag="{x:Static models:PersonListProperty.Age}" />
                    <ComboBoxItem Content="IsAdult"
                                  Tag="{x:Static models:PersonListProperty.IsAdult}" />
                    <ComboBoxItem Content="SunSign"
                                  Tag="{x:Static models:PersonListProperty.SunSign}" />
                    <ComboBoxItem Content="ChineseSign"
                                  Tag="{x:Static models:PersonListProperty.ChineseSign}" />
                    <ComboBoxItem Content="IsBirthday"
                                  Tag="{x:Static models:PersonListProperty.IsBirthday}" />
                </ComboBox>
                <CheckBox Grid.Row="2"
                          Grid.Column="2"
                          FontSize="14"
                          Margin="5"
                          Content="IsAscending"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          IsChecked="{Binding IsAscending, Mode=TwoWay}" />
                <Button Grid.Row="2"
                        Grid.Column="3"
                        Margin="5"
                        Padding="10 3 10 3"
                        MinWidth="75"
                        FontSize="14"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Sort"
                        Command="{Binding SortListCommand}"
                        Width="125" />
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Filter by category: "
                           Margin="5"
                           VerticalAlignment="Center"
                           FontSize="14" />
                <ComboBox Grid.Row="3"
                          Grid.Column="1"
                          MinWidth="125"
                          FontSize="14"
                          VerticalAlignment="Center"
                          Margin="5"
                          SelectedValue="{Binding FilterListProperty, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="None"
                                  Tag="{x:Static models:PersonListProperty.None}"
                                  Visibility="Collapsed"/>
                    <ComboBoxItem Content="Name"
                                  Tag="{x:Static models:PersonListProperty.Name}" />
                    <ComboBoxItem Content="Surname"
                                  Tag="{x:Static models:PersonListProperty.Surname}" />
                    <ComboBoxItem Content="Email"
                                  Tag="{x:Static models:PersonListProperty.Email}" />
                    <ComboBoxItem Content="Birthday"
                                  Tag="{x:Static models:PersonListProperty.Birthday}" />
                    <ComboBoxItem Content="Age"
                                  Tag="{x:Static models:PersonListProperty.Age}" />
                    <ComboBoxItem Content="IsAdult"
                                  Tag="{x:Static models:PersonListProperty.IsAdult}" />
                    <ComboBoxItem Content="SunSign"
                                  Tag="{x:Static models:PersonListProperty.SunSign}" />
                    <ComboBoxItem Content="ChineseSign"
                                  Tag="{x:Static models:PersonListProperty.ChineseSign}" />
                    <ComboBoxItem Content="IsBirthday"
                                  Tag="{x:Static models:PersonListProperty.IsBirthday}" />
                </ComboBox>
                <xctk:WatermarkTextBox Grid.Row="3"
                                       Grid.Column="2"
                                       FontSize="14"
                                       Margin="5"
                                       Width="200"
                                       VerticalAlignment="Center"
                                       VerticalContentAlignment="Center"
                                       Watermark="Enter text"
                                       Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="3"
                        Grid.Column="3"
                        Margin="5"
                        Padding="10 3 10 3"
                        MinWidth="75"
                        FontSize="14"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Filter"
                        Command="{Binding FilterListCommand}"
                        Width="125" />
                <Button Grid.Row="4"
                        Grid.Column="3"
                        Margin="5"
                        Padding="10 3 10 3"
                        MinWidth="75"
                        FontSize="14"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Reset sort/filter"
                        Command="{Binding ResetSortFilterCommand}"
                        Width="125" />
            </Grid>
            <DataGrid Grid.Row="1"
                      FontSize="14"
                      ItemsSource="{Binding PersonList}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="0.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Edit"
                                        Command="{Binding DataContext.GotoEditUserCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding Email}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="0.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.RemoveUserCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding Email}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*" />
                    <DataGridTextColumn Header="Surname"
                                        Binding="{Binding Surname}"
                                        Width="*" />
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="1.8*" />
                    <DataGridTextColumn Header="Birthday"
                                        Binding="{Binding Birthday, StringFormat='dd.MM.yyyy'}"
                                        Width="*" />
                    <DataGridTextColumn Header="Age"
                                        Binding="{Binding Age}"
                                        Width="*" />
                    <DataGridTextColumn Header="IsAdult"
                                        Binding="{Binding IsAdult, Converter={StaticResource BooleanToDisplayValueConverter}}"
                                        Width="*" />
                    <DataGridTextColumn Header="SunSign"
                                        Binding="{Binding SunSign}"
                                        Width="*" />
                    <DataGridTextColumn Header="ChineseSign"
                                        Binding="{Binding ChineseSign}"
                                        Width="*" />
                    <DataGridTextColumn Header="IsBirthday"
                                        Binding="{Binding IsBirthday, Converter={StaticResource BooleanToDisplayValueConverter}}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Background="#60808080"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="LOADING..." FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>