<UserControl x:Class="Lab4.PersonList.Views.PersonInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:convertors="clr-namespace:Lab4.PersonList.Convertors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800" d:DataContext="{d:DesignData }">
    <UserControl.Resources>
        <convertors:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"
                                                 FalseVisibility="Hidden" />
        <convertors:NullToVisibilityConverter x:Key="NullToVisibilityConverter"
                                              Visibility="Hidden" />
        <convertors:BooleanToDisplayValueConverter x:Key="BooleanToDisplayValueConverter"
                                                   TrueDisplayValue="Yes"
                                                   FalseDisplayValue="No" />
    </UserControl.Resources>
    <Grid>
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Margin="0,0, 20, 0" MinWidth="200">
                    <xctk:WatermarkTextBox Watermark="Enter your name"
                                           Margin="5"
                                           Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <xctk:WatermarkTextBox Watermark="Enter your surname"
                                           Margin="5"
                                           Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <xctk:WatermarkTextBox Watermark="Enter your email"
                                           Margin="5"
                                           Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <xctk:DateTimePicker Margin="5"
                                         Value="{Binding Birthday, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         ShowButtonSpinner="False"
                                         Format="Custom"
                                         Watermark="Select you birthday"
                                         FormatString="dd.MM.yyyy"
                                         TimePickerVisibility="Hidden" />
                    <Button Margin="5"
                            Content="Proceed"
                            Command="{Binding ProceedCommand}" />
                </StackPanel>
                <StackPanel Orientation="Vertical"
                            Margin="20,0, 0, 0"
                            MinWidth="200"
                            Visibility="{Binding Person, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.Name, StringFormat='Name: {0}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.Surname, StringFormat='Surname: {0}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.Email , StringFormat='Email: {0}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.Birthday, StringFormat='Birthday: {0:dd.MM.yyyy}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.IsAdult, StringFormat='Is Adult: {0}', Converter={StaticResource BooleanToDisplayValueConverter}}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.SunSign,  StringFormat='Sun Sign: {0}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="12"
                               Text="{Binding Person.ChineseSign, StringFormat='Chinese Sign: {0}'}" />
                    <TextBlock HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Height="20"
                               Margin="5"
                               FontSize="16"
                               Text="Happy Birthday!"
                               FontWeight="Bold"
                               FontFamily="Comic Sans MS"
                               Background="Yellow"
                               Foreground="LightGreen"
                               Visibility="{Binding Person.IsBirthday, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Background="#60808080"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="LOADING..." FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>