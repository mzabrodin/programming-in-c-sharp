<UserControl x:Class="Lab4.PersonList.Views.PersonCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:convertors="clr-namespace:Lab4.PersonList.Convertors"
             xmlns:viewModels="clr-namespace:Lab4.PersonList.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PersonCreateViewModel}">
    <UserControl.Resources>
        <convertors:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"
                                                 TrueVisibility="Visible"
                                                 FalseVisibility="Hidden" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Vertical"
                    MinWidth="200"
                    Height="300"
                    Width="400">
            <TextBlock Text="Create person"
                       Margin="5"
                       FontSize="20"
                       FontWeight="Bold" />
            <xctk:WatermarkTextBox Watermark="Enter name"
                                   Margin="5"
                                   FontSize="14"
                                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <xctk:WatermarkTextBox Watermark="Enter surname"
                                   Margin="5"
                                   FontSize="14"
                                   Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <xctk:WatermarkTextBox Watermark="Enter email"
                                   Margin="5"
                                   FontSize="14"
                                   Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <xctk:DateTimePicker Margin="5"
                                 FontSize="14"
                                 Value="{Binding Birthday, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 ShowButtonSpinner="False"
                                 Format="Custom"
                                 Watermark="Select birthday"
                                 FormatString="dd.MM.yyyy"
                                 TimePickerVisibility="Hidden" />
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Margin="5"
                        FontSize="14"
                        Content="Create"
                        Command="{Binding PersonCreateCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        Margin="5"
                        FontSize="14"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
        <Grid Background="#60808080"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="LOADING..." FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>