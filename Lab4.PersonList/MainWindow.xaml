<Window x:Class="Lab4.PersonList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4.PersonList"
        xmlns:views="clr-namespace:Lab4.PersonList.Views"
        xmlns:viewsModels="clr-namespace:Lab4.PersonList.ViewModels"
        xmlns:convertors="clr-namespace:Lab4.PersonList.Convertors"
        mc:Ignorable="d"
        Title="Lab04 - Person List"
        MinHeight="600"
        MinWidth="1000"
        d:DataContext="{d:DesignInstance Type=viewsModels:MainWindowViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewsModels:PersonListViewModel}">
            <views:PersonsListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewsModels:PersonCreateViewModel}">
            <views:PersonCreateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewsModels:PersonEditViewModel}">
            <views:PersonEditView />
        </DataTemplate>
        <convertors:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"
                                                 TrueVisibility="Visible"
                                                 FalseVisibility="Hidden" />
    </Window.Resources>
    <Grid>
        <Grid>
            <ContentControl Content="{Binding CurrentViewModel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

    </Grid>
</Window>